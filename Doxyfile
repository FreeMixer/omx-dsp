# libomxdsp API reference — docs/design/specs/2026-09-26-dsp-primitives.md §6.
# Build-time only: `make docs`; never a runtime dependency of the console.
PROJECT_NAME           = libomxdsp
PROJECT_BRIEF          = "openmixer's DSP primitives: one header per building block"
OUTPUT_DIRECTORY       = build/docs
INPUT                  = include/omxdsp
FILE_PATTERNS          = *.h
RECURSIVE              = NO
EXCLUDE                = include/omxdsp/omx_contract_limits.h
OPTIMIZE_OUTPUT_FOR_C  = YES
EXTRACT_ALL            = NO
EXTRACT_STATIC         = YES
HIDE_UNDOC_MEMBERS     = NO
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = YES
QUIET                  = YES
GENERATE_HTML          = YES
GENERATE_MAN           = YES
MAN_LINKS              = NO
GENERATE_LATEX         = NO
SOURCE_BROWSER         = NO
ALPHABETICAL_INDEX     = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = OMX_CONTRACTS __x86_64__
ALIASES               += "pre=\par Precondition:^^" \
                         "post=\par Postcondition:^^" \
                         "invariant=\par Invariant:^^"
HAVE_DOT               = NO
EXCLUDE_SYMBOLS        = OMX_CONTRACT_STAGE M_PI
