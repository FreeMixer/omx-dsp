    {
      "name": "mix",
      "kind": "travel",
      "table": "PITCH_LIMITS",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 0.1,
        "unit": "%",
        "default": 100,
        "defaultFrom": "desk"
      }
    }
  ],
  "tables": {
    "PITCH_LIMITS": {
      "source": {
        "from": {
          "link": "packages/core/src/pitch-kernel.ts#PITCH_LIMITS",
          "at": "openmixer@964a798356925f6bc3774459d9904362b9d3f986"
        }
      },
      "doc": "The pitch shifter's control travels: the shift in whole semitones (-12 to 12), the fine shift in cents (-50 to 50), and the wet share in percent, on the drive's mix travel so the modulation family shares one word and unit. A fresh shifter is fully wet, the mix travel's own top."
    }
  },
  "constants": {
    "PITCH_KERNEL": {
      "kind": "sheet",
      "source": {
        "from": {
          "link": "packages/core/src/pitch-kernel.ts#PITCH_KERNEL",
          "at": "openmixer@964a798356925f6bc3774459d9904362b9d3f986"
        }
      },
      "doc": "The pitch kernel's constants that are not a control's travel. `windowMs` is the crossfade window in ms, declared rather than a control and whole in samples at every rate; `prefilterCeilingHz` is the pre-filter's highest corner, the corner being min(ceiling, sample rate / (2 x ratio)); `prefilterQ` is its Q, a second-order Butterworth.",
      "value": {
        "windowMs": 40,
        "prefilterCeilingHz": 20000,
        "prefilterQ": {
          "ref": "BUTTERWORTH_Q"
        }
      }
    }
  }
