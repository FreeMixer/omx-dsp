{
  "$schema": "../../schema/omx-contract.schema.json",
  "requires": {
    "omx-contract-schema": ">= 2.15.0"
  },
  "controls": [
    {
      "name": "hornSlowHz",
      "kind": "travel",
      "global": "ROTARY_HORN_SLOW_RANGE",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary_instance.h#horn_slow_hz"
      },
      "doc": "The horn's chorale (slow) rate, Hz.",
      "travel": {
        "min": 0.1,
        "max": 2,
        "step": 0.01,
        "unit": "Hz",
        "default": 0.8,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "hornFastHz",
      "kind": "travel",
      "global": "ROTARY_HORN_FAST_RANGE",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary_instance.h#horn_fast_hz"
      },
      "doc": "The horn's tremolo (fast) rate, Hz.",
      "travel": {
        "min": 3,
        "max": 10,
        "step": 0.01,
        "unit": "Hz",
        "default": 6.8,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "drumSlowHz",
      "kind": "travel",
      "global": "ROTARY_DRUM_SLOW_RANGE",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary_instance.h#drum_slow_hz"
      },
      "doc": "The drum's chorale (slow) rate, Hz.",
      "travel": {
        "min": 0.1,
        "max": 2,
        "step": 0.01,
        "unit": "Hz",
        "default": 0.7,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "drumFastHz",
      "kind": "travel",
      "global": "ROTARY_DRUM_FAST_RANGE",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary_instance.h#drum_fast_hz"
      },
      "doc": "The drum's tremolo (fast) rate, Hz.",
      "travel": {
        "min": 3,
        "max": 10,
        "step": 0.01,
        "unit": "Hz",
        "default": 5.9,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "accel",
      "kind": "travel",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary_instance.h#accel"
      },
      "doc": "The scale on every speed-change time constant (`ROTARY_*_ACCEL_MS`/`_DECEL_MS`): 2 is twice as slow.",
      "travel": {
        "min": 0.25,
        "max": 4,
        "step": 0.01,
        "unit": "x",
        "default": 1,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "balance",
      "kind": "travel",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary_instance.h#balance"
      },
      "doc": "The drum/horn balance, percent: −100 drum only, +100 horn only; the law attenuates, never boosts.",
      "travel": {
        "min": -100,
        "max": 100,
        "step": 1,
        "unit": "%",
        "default": 0,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "mix",
      "kind": "travel",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary_instance.h#mix"
      },
      "doc": "The rotary's wet/dry, as an instance of DRIVE_MIX_RANGE: 100 %, because a rotary on an insert IS the sound (it replaces the cabinet) and an `fxReturn` wants it wet too.",
      "travel": {
        "min": 0,
        "max": 100,
        "step": 0.1,
        "unit": "%",
        "default": 100,
        "defaultFrom": "desk"
      }
    },
    {
      "name": "speed",
      "kind": "choice",
      "doc": "The rotary speaker's speed settings, in the order of the integer the kernel reads: the rotors stopped, at their chorale (slow) rate, or at their tremolo (fast) rate.",
      "ids": [
        "stop",
        "slow",
        "fast"
      ]
    }
  ],
  "aggregates": {
    "ROTARY_TRAVELS": {
      "doc": "The rotary's numeric travels, field → declaration: the ONE map the row's state, its bounds, its OPTIONS and its controller read (`speed` is a member set, ROTARY_SPEEDS, beside it).",
      "fields": [
        "hornSlowHz",
        "hornFastHz",
        "drumSlowHz",
        "drumFastHz",
        "accel",
        "balance",
        "mix"
      ]
    }
  },
  "constants": {
    "ROTARY_CROSSOVER_HZ": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary.h#omx_rotary_resolve"
      },
      "doc": "The complementary split's low-pass corner, Hz: the Leslie 122's passive crossover.",
      "unit": "Hz",
      "value": 800
    },
    "ROTARY_BASE_MS": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotor.h#base"
      },
      "doc": "The shortest Doppler read, ms — above the order-3 read's one-sample reach at every rate.",
      "unit": "ms",
      "value": 0.1
    },
    "ROTARY_HORN_DOPPLER_MS": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary.h#omx_rotary_resolve"
      },
      "doc": "The horn's Doppler excursion `D_horn`, ms: a 0.15 m radius over 343 m/s.",
      "unit": "ms",
      "value": 0.44
    },
    "ROTARY_DRUM_DOPPLER_MS": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary.h#omx_rotary_resolve"
      },
      "doc": "The drum's Doppler excursion `D_drum`, ms: its baffle turns over a fixed woofer.",
      "unit": "ms",
      "value": 0.29
    },
    "ROTARY_HORN_AM": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary.h#omx_rotary_resolve"
      },
      "doc": "The horn's amplitude swing `m_horn` (a −6 dB directivity dip), a ratio.",
      "unit": "",
      "value": 0.5
    },
    "ROTARY_DRUM_AM": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary.h#omx_rotary_resolve"
      },
      "doc": "The drum baffle's amplitude swing `m_drum`, a ratio.",
      "unit": "",
      "value": 0.3
    },
    "ROTARY_HORN_ACCEL_MS": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary.h#omx_rotary_resolve"
      },
      "doc": "The horn rotor's speed-up time constant, ms (at `accel` 1).",
      "unit": "ms",
      "value": 330
    },
    "ROTARY_HORN_DECEL_MS": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary.h#omx_rotary_resolve"
      },
      "doc": "The horn rotor's slow-down time constant, ms (at `accel` 1).",
      "unit": "ms",
      "value": 500
    },
    "ROTARY_DRUM_ACCEL_MS": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary.h#omx_rotary_resolve"
      },
      "doc": "The drum rotor's speed-up time constant, ms (at `accel` 1).",
      "unit": "ms",
      "value": 1700
    },
    "ROTARY_DRUM_DECEL_MS": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary.h#omx_rotary_resolve"
      },
      "doc": "The drum rotor's slow-down time constant, ms (at `accel` 1).",
      "unit": "ms",
      "value": 1800
    },
    "ROTARY_STOP_EPS": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotor.h#omx_rotor_step"
      },
      "doc": "Below this rate, Hz, a rotor coasting toward `stop` is snapped to exactly 0.",
      "unit": "",
      "value": 0.0001
    },
    "ROTARY_RING_FLOATS": {
      "kind": "scalar",
      "source": {
        "impl": "include/omxdsp/fx/omx_rotary.h#c"
      },
      "doc": "One inline ring per rotor per leg, floats — at least the 192 kHz need of the horn's sweep.",
      "unit": "",
      "value": 256
    }
  }
}
