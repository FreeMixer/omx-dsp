{
  "name": "@openmixer/omx-dsp",
  "version": "0.27.0",
  "description": "The TypeScript twins of omx-dsp kernels, each pinned to its C kernel by an agreement test",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "author": "Pau Aliagas <linuxnow@gmail.com>",
  "homepage": "https://github.com/FreeMixer/omx-dsp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreeMixer/omx-dsp.git",
    "directory": "ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node tools/definitions.mjs --check && tsc -p tsconfig.json && node --test test/*.test.mjs",
    "prepack": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
