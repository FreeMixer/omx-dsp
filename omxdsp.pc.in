prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@
datadir=@DATADIR@
# the exports file omx-dsp-copy-check reads
exports=${datadir}/omxdsp/omx-dsp-exports.json

Name: @NAME@
Description: DSP primitives and effect kernels of OpenMixer, linked statically (@FLAVOUR@)
Version: @VERSION@
Requires: omx-contract >= @CONTRACTFLOOR@
Cflags: -I${includedir} @FPFLAGS@@CFLAGS@
Libs: -L${libdir} -l@NAME@@LIBS@ -lm
