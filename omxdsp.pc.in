prefix=@PREFIX@
libdir=@LIBDIR@
includedir=@INCLUDEDIR@

Name: omxdsp
Description: DSP primitives and effect kernels of OpenMixer, linked statically
Version: @VERSION@
Cflags: -I${includedir} @FPFLAGS@
Libs: -L${libdir} -lomxdsp -lm
