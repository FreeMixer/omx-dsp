prefix=/usr
libdir=/usr/lib/x86_64-linux-gnu
includedir=/usr/include
datadir=/usr/share
# the exports file omx-dsp-copy-check reads
exports=${datadir}/omxdsp/omx-dsp-exports.json
# the golden matched-Z peaking corpus (test/analysis/hrp_peaking_corpus.h) a consumer's HRP twins are read against
hrpcorpus=${datadir}/omxdsp/hrp_peaking_corpus.h

Name: omxdsp-tsan
Description: DSP primitives and effect kernels of OpenMixer, linked statically (contracts compiled in, under ThreadSanitizer)
Version: 0.26.0
Requires: omx-contract >= 3.1.0
Cflags: -I${includedir} -ffp-contract=off -DOMX_CONTRACTS -fsanitize=thread
Libs: -L${libdir} -lomxdsp-tsan -fsanitize=thread -lm
